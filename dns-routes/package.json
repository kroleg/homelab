{
  "name": "dns-routes",
  "version": "1.0.0",
  "description": "UI for Keenetic's native DNS-based routing",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env --watch src/server.ts",
    "start:prod": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "check:views": "find src/views -name '*.pug' -exec node -e 'require(\"pug\").compileFile(process.argv[1])' {} \\;"
  },
  "dependencies": {
    "express": "^5.0.1",
    "pug": "^3.0.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
